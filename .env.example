# ARIA environment variables
# Copy this file to .env and fill in local values. Never commit real secrets.

# Application mode: development, testing, or production.
APP_ENV=development

# Required for OTP HMAC hashing. Use a long random string in deployed apps.
# Generate locally with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=EQY_dXw7PiR8dNHxhXqWwuvurlJeMEC0Nec8MkSzGaEywbsmbATkTryaxfYaDZ7C

# SQLite database path. Relative paths are resolved from the project root.
ARIA_DB_PATH=aria.db

# Groq API key for LangChain AI recommendations.
# Leave empty if you only want dashboard/analytics features.
GROQ_API_KEY=your_groq_api_key_here
CLOUD_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# Localhost OTP testing. Keep true locally if SMTP is not configured.
# Production must use false and real SMTP credentials.
EMAIL_DEV_MODE=false
EMAIL_SENDER=manavkhandelwal06@gmail.com
EMAIL_PASSWORD=agfi qrga fffy pyzv

# Optional fixed receiver used only by daily_runner.py high-risk alerts.
EMAIL_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Localhost verification. Keep true locally for the built-in dev check.
# Production must use false and real Google reCAPTCHA v2 checkbox keys.
